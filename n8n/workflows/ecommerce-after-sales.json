    },
    {
      "parameters": {
        "url": "={{ 'http://mock-api:8000/shipments/' + $('Extract Event').first().json.shipment_id }}",
        "options": {}
      },
      "id": "34f303f2-5b39-4ceb-930c-2f975ad0c186",
      "name": "Get Shipment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [880, 0]
    },
    {
      "parameters": {
        "url": "={{ 'http://mock-api:8000/inventory/' + $('Extract Event').first().json.sku }}",
        "options": {}
      },
      "id": "88ea65dd-a42c-4938-9e89-713d9267ab0b",
      "name": "Get Inventory",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "jsCode": "const event = $('Extract Event').first().json;\nreturn [{\n  json: {\n    event_id: event.event_id,\n    event_type: event.event_type,\n    source: event.source,\n    customer: $('Get Customer').first().json,\n    order: $('Get Order').first().json,\n    inventory: $('Get Inventory').first().json,\n    shipment: $('Get Shipment').first().json,\n    message: event.message,\n    created_at: event.created_at,\n  },\n}];"
      },
      "id": "65909071-bacd-4027-b088-4add2e53d5c4",
      "name": "Build AI Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ai-service:8000/decide",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {}
      },
      "id": "720a6474-e46c-45e2-aa6c-9a172d72e83d",
      "name": "Decide Action",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1540, 0]
    },
    {
      "parameters": {
        "jsCode": "const event = $('Extract Event').first().json;\nconst decision = $input.first().json;\nconst requiresApproval = Boolean(decision.requires_approval);\nconst isLowStock = decision.category === 'low_stock';\nconst actionUrl = requiresApproval\n  ? 'http://mock-api:8000/approval-requests'\n  : isLowStock\n    ? 'http://mock-api:8000/internal-notifications'\n    : 'http://mock-api:8000/tickets';\nconst actionBody = requiresApproval\n  ? {\n      event_id: event.event_id,\n      recommended_action: decision.recommended_action,\n      explanation: decision.explanation,\n    }\n  : {\n      event_id: event.event_id,\n      summary: decision.internal_task_summary,\n      team: isLowStock ? 'procurement' : 'support',\n    };\nreturn [{ json: { event, decision, action_url: actionUrl, action_body: actionBody, started_at: Date.now() } }];"
      },
      "id": "2f2dc35d-217d-493e-b954-51e064ed6a4b",
      "name": "Build Action Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.action_url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ $json.action_body }}",
        "options": {}
      },
      "id": "10d7713b-01a2-4561-8e93-16fe73f9c9a9",
      "name": "Create Business Action",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1980, 0]
    },
    {
      "parameters": {
        "jsCode": "const action = $('Build Action Request').first().json;\nconst actionResult = $input.first().json;\nconst runLogBody = {\n  event_id: action.event.event_id,\n  workflow_id: 'wf_after_sales',\n  status: 'succeeded',\n  latency_ms: Date.now() - action.started_at,\n  model: 'fake',\n  estimated_tokens: 0,\n  error: null,\n};\nreturn [{ json: { event: action.event, decision: action.decision, action_result: actionResult, run_log_body: runLogBody } }];"
      },
      "id": "0064971d-7b90-45b0-a5ca-685363a38576",
      "name": "Build Run Log",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2200, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://mock-api:8000/run-logs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ $json.run_log_body }}",
        "options": {}
      },
      "id": "c4d8fd2a-af7a-4730-bc59-23ed3fb03e6d",
      "name": "Create Run Log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [2420, 0]
    },
    {
      "parameters": {
        "jsCode": "const payload = $('Build Run Log').first().json;\nconst runLog = $input.first().json;\nreturn [{\n  json: {\n    event: payload.event,\n    decision: payload.decision,\n    action_result: payload.action_result,\n    run_log: runLog,\n  },\n}];"
      },
      "id": "407114c1-7d97-4a79-b86c-799b69c6b23f",
