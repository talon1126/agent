      },
      "id": "79864ca9-cbb8-4891-9d08-159d1ddf9051",
      "name": "Get Order",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [440, 0]
    },
    {
      "parameters": {
        "url": "={{ 'http://mock-api:8000/customers/' + $('Extract Event').first().json.customer_id }}",
