{
  "id": "wf_ecommerce_after_sales",
  "name": "Ecommerce After-sales Agent Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "after-sales-event",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b4ec5c1b-4c3b-4b5f-b507-b24311fe3c5a",
