      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "after-sales-event"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.body ?? $input.first().json;\nreturn [{ json: raw }];"
      },
      "id": "b24743e4-0e8c-4f78-b7ad-3f9ea07dfb61",
      "name": "Extract Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "url": "={{ 'http://mock-api:8000/orders/' + $json.order_id }}",
