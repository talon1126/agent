          "action_preview": "#/$defs/AiModelActionPreviewPayload",
          "action_result": "#/$defs/AiModelActionResultPayload",
          "answer": "#/$defs/AiModelAnswerPayload",
          "clarification": "#/$defs/AiModelClarificationPayload",
          "comparison": "#/$defs/AiModelComparisonPayload",
          "fallback": "#/$defs/AiModelFallbackPayload",
          "product_list": "#/$defs/AiModelProductListPayload",
          "recommendation": "#/$defs/AiModelRecommendationPayload"
