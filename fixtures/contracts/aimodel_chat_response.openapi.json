        "answer": {
          "maxLength": 16000,
          "minLength": 1,
          "title": "Answer",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/AiModelEvidenceReference"
          },
          "title": "Evidence",
          "type": "array"
        },
        "products": {
          "items": {
            "$ref": "#/$defs/AiModelProductRef"
          },
          "maxItems": 20,
          "title": "Products",
          "type": "array"
        },
        "response_type": {
          "const": "action_preview",
          "default": "action_preview",
          "title": "Response Type",
          "type": "string"
        },
        "schema_version": {
          "const": "v1",
          "default": "v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "answer",
        "action"
      ],
      "title": "AiModelActionPreviewPayload",
      "type": "object"
