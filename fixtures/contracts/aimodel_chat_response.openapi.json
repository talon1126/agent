    "AiModelActionPreview": {
      "additionalProperties": false,
      "properties": {
        "action_token": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Action Token",
          "type": "string"
        },
        "action_type": {
          "enum": [
            "add_to_cart",
            "remove_from_cart",
            "compare",
            "open_item"
          ],
