      "oneOf": [
        {
          "$ref": "#/$defs/AiModelAnswerPayload"
        },
        {
          "$ref": "#/$defs/AiModelClarificationPayload"
        },
        {
          "$ref": "#/$defs/AiModelProductListPayload"
        },
        {
          "$ref": "#/$defs/AiModelComparisonPayload"
