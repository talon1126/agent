          "type": "string"
        },
        "summary": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "target_item_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Item Id"
        }
      },
      "required": [
        "action_type",
        "action_token",
        "summary"
      ],
      "title": "AiModelActionPreview",
      "type": "object"
    },
    "AiModelActionPreviewPayload": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/AiModelActionPreview"
